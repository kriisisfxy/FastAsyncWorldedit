# PostgreSQL connection string
DATABASE_URL="postgresql://stream:stream@localhost:5432/stream?schema=public"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="change-me"
# Public base URL (used in password-reset links)
APP_URL="http://localhost:3000"

# Optional: Cloudinary image storage. If unset, uploads are stored in public/uploads.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional: SMTP for password-recovery emails. If unset, the reset link is printed to the server log.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Nocturne <no-reply@example.com>"

# Seed admin account (used by `npm run db:seed`)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
